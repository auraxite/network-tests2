Bootstrap: docker
From: ubuntu:20.04

%post
    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime

    apt update
    apt install -y build-essential \
                   gcc g++ \
                   openmpi-bin libopenmpi-dev \
                   libnuma-dev \
                   tzdata

    apt clean