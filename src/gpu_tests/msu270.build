#!/bin/sh

# Сборка gpu_benchmark: Open MPI с CUDA, NetCDF, CUDA toolkit.
#
# На кластере с логина (один GPU-узел, те же переменные подставятся в job):
#   export OMPI_PREFIX=/scratch/asalnikov/opt/openmpi-5.0.10-cuda
#   export NETCDF_HOME=/scratch/asalnikov/opt/netcdf-c-4.9.2
#   export CUDA_ROOT=/usr/local/cuda
#   export UCX_PREFIX=/scratch/asalnikov/opt/ucx-1.15.0   # если OMPI собран с --with-ucx
#   sh msu270.build srun


set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_GPU_TESTS="$SCRIPT_DIR"
SELF="$SCRIPT_DIR/msu270.build"

OMPI_PREFIX="${OMPI_PREFIX:-$HOME/opt/openmpi-5.0.10-cuda}"
NETCDF_HOME="${NETCDF_HOME:-$HOME/opt/netcdf-c-4.9.2}"
CUDA_ROOT="${CUDA_ROOT:-/usr/local/cuda}"
UCX_PREFIX="${UCX_PREFIX:-$HOME/opt/ucx-1.15.0}"

case "${1:-}" in
srun|remote)
	SRUN_NODES="${SRUN_NODES:-1}"
	SRUN_GPUS="${SRUN_GPUS:-1}"
	SRUN_TIME="${SRUN_TIME:-00:30:00}"
	SRUN_PART=""
	if [ -n "${SRUN_PARTITION:-}" ]; then
		SRUN_PART="-p $SRUN_PARTITION"
	fi
	exec srun $SRUN_PART -N"${SRUN_NODES}" --gpus="${SRUN_GPUS}" --time="${SRUN_TIME}" bash -lc \
		"export OMPI_PREFIX=\"$OMPI_PREFIX\"; export NETCDF_HOME=\"$NETCDF_HOME\"; export CUDA_ROOT=\"$CUDA_ROOT\"; export UCX_PREFIX=\"$UCX_PREFIX\"; cd \"$REPO_GPU_TESTS\" && exec sh \"$SELF\" build"
	;;
build)
	shift
	;;
esac

export PATH="$OMPI_PREFIX/bin:$PATH"
if [ -d "$UCX_PREFIX/lib" ]; then
	export LD_LIBRARY_PATH="$UCX_PREFIX/lib:$OMPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"
else
	export LD_LIBRARY_PATH="$OMPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"
fi

MPICC="$OMPI_PREFIX/bin/mpicc"
MPICXX="$OMPI_PREFIX/bin/mpicxx"

for x in "$MPICC" "$MPICXX"; do
	test -x "$x" || { echo "msu270.build: not executable: $x" >&2; exit 1; }
done

if ! test -f "$NETCDF_HOME/include/netcdf.h"; then
	echo "msu270.build: missing $NETCDF_HOME/include/netcdf.h (set NETCDF_HOME)" >&2
	exit 1
fi
if ! test -f "$CUDA_ROOT/include/cuda_runtime.h"; then
	echo "msu270.build: missing $CUDA_ROOT/include/cuda_runtime.h" >&2
	echo "  На login-узле часто нет CUDA headers — запусти: sh msu270.build srun" >&2
	exit 1
fi

echo "$MPICXX"
"$MPICXX" --showme:version 2>/dev/null || true

CFLAGS="-O2 -fPIC -I$NETCDF_HOME/include"
CXXFLAGS="-O2 -I$NETCDF_HOME/include -I$CUDA_ROOT/include"
RPATH="-Wl,-rpath,$OMPI_PREFIX/lib -Wl,-rpath,$NETCDF_HOME/lib -Wl,-rpath,$CUDA_ROOT/lib64"
if [ -d "$UCX_PREFIX/lib" ]; then
	RPATH="-Wl,-rpath,$UCX_PREFIX/lib $RPATH"
fi

"$MPICC" $CFLAGS -c "$REPO_GPU_TESTS/../core/data_write_operations.c" \
	-o "$REPO_GPU_TESTS/../core/data_write_operations.o"
"$MPICC" $CFLAGS -c "$REPO_GPU_TESTS/../core/string_id_converters.c" \
	-o "$REPO_GPU_TESTS/../core/string_id_converters.o"

"$MPICXX" $CXXFLAGS \
	"$REPO_GPU_TESTS/gpu_benchmark.cpp" \
	"$REPO_GPU_TESTS/gpu_benchmark_common.cpp" \
	"$REPO_GPU_TESTS/gpu_benchmark_one_to_one.cpp" \
	"$REPO_GPU_TESTS/gpu_benchmark_all_to_all.cpp" \
	"$REPO_GPU_TESTS/netcdf_writer.cpp" \
	"$REPO_GPU_TESTS/../core/data_write_operations.o" \
	"$REPO_GPU_TESTS/../core/string_id_converters.o" \
	-o "$REPO_GPU_TESTS/gpu_benchmark" \
	$RPATH \
	-Wl,--no-as-needed \
	-L"$OMPI_PREFIX/lib" -lmpi -lopen-rte -lopen-pal \
	-Wl,--as-needed \
	-L"$NETCDF_HOME/lib" -lnetcdf \
	-L"$CUDA_ROOT/lib64" -lcudart

echo "OK: $REPO_GPU_TESTS/gpu_benchmark"
ldd "$REPO_GPU_TESTS/gpu_benchmark" | grep -E 'libmpi|libmpi_cxx|open-pal|libcudart|libnetcdf|libucp|libuct' || true
